module TOP#(
 parameter QCP_REQ_ROP_W = 6
 , QCP_REQ_TSIZE_W = 7
 , QCP_REQ_ADDR_W = 20
 , QCP_REQ_DID_W = 5
 , QCP_REQ_CTIDX_W = 4
 , QCP_REQ_OPC_W = 2
 , QCP_REQ_SF_W = 4
 , QCP_REQ_BURST_W = 1
 , QCP_RSP_OPC_W = 4
,  PLD_W = 8
 , QCP_RSP_CTIDX_W = 5
,  FIFO_WIDTH = 32
 , QCP_RSP_TSIZE_W = 7
 , QCP_RSP_ADDR_W = 20
 ,
localparam WA_QCP_REQ_PLD_W = QCP_REQ_DID_W
 + QCP_REQ_CTIDX_W
 + QCP_REQ_OPC_W
 + QCP_REQ_SF_W
 + QCP_REQ_BURST_W
 + QCP_REQ_ADDR_W
 + QCP_REQ_TSIZE_W
 + 27 
 + 4 ,
localparam WA_QCP_REQ_PACK_W = 1 
 +1
 +QCP_REQ_ROP_W
 +WA_QCP_REQ_PLD_W ,
localparam LOCAL_REQ_FIFO_W = WA_QCP_REQ_PACK_W 
)(
input cfg_rsp_err,wreq_access,cfg_rsp_vld,
input valid_s,ready_m,
input reset_n,
input clk,
input [LOCAL_REQ_FIFO_W -1:0] pload_s,
input req_block_n,
output valid_m,
output wire ready_s,
output reg cfg_rsp_err_rec
);
wire [PLD_W-1:0]pload_m;
wire [WA_QCP_REQ_PACK_W -1:0]req_pack;
wire [WA_QCP_REQ_PLD_W -1:0] req_pld ;
wire req_hop ;
wire req_top ;
wire [QCP_REQ_ROP_W -1:0] req_rop ;
wire [4 -1:0] req_be ;
wire [32 -1:0] req_data ;
wire [QCP_REQ_TSIZE_W -1:0] req_tsize ;
wire [QCP_REQ_ADDR_W -1:0] req_addr ;
wire req_burst ;
wire [LOCAL_REQ_FIFO_W -1:0]local_req_fifo_rdata;
wire [QCP_REQ_SF_W -1:0] req_sf ;
wire [QCP_REQ_OPC_W -1:0] req_opc ;
wire [QCP_REQ_CTIDX_W -1:0] req_ctidx ;
wire [QCP_REQ_DID_W -1:0] req_did ;
wire req_wcmd_vld;
wire req_vld ;
wire req_type ;
wire local_req_fif0_avl ; 
wire req_cmd_vld ;
wire req_wrap ;
reg [QCP_REQ_SF_W -1:0] req_sf_hold ;
reg [QCP_REQ_TSIZE_W -1:0] req_tsize_hold ;
reg req_wrap_hold ;
reg req_type_hold ;
reg [QCP_RSP_TSIZE_W-1:0]rsp_tsize;
reg [QCP_RSP_TSIZE_W-1:0]wrsp_addr;
reg rsp_burst;
wire [LOCAL_REQ_FIFO_W-1:0]rdata;
wire [LOCAL_REQ_FIFO_W-1:0]rs_load_m;
reg [QCP_RSP_OPC_W-1:0]rsp_opc;
reg [QCP_RSP_CTIDX_W-1:0]rsp_ctidx;
 QIC_CBB_RS_FWD #(
 .PLD_W (LOCAL_REQ_FIFO_W ) 
 ) U_QIC_CBB_RS_FWD (
 .clk (clk ),
 .reset_n (reset_n ),
 .valid_s (valid_s ),
 .ready_s (ready_s ),
 .pload_s (pload_s ),
 .valid_m (valid_m ),
 .ready_m (ready_m ),
 .pload_m (rs_load_m )
 );
assign rdata = rs_load_m;
assign local_req_fifo_rdata = rdata;;
assign req_cmd_vld = req_vld && req_hop;
assign req_pack = local_req_fifo_rdata ; 
assign {req_hop 
 ,req_top 
 ,req_rop
 ,req_pld} = req_pack;
assign {req_be 
 ,req_data
 ,req_tsize
 ,req_addr
 ,req_burst
 ,req_sf
 ,req_opc
 ,req_ctidx
 ,req_did} = req_pld;
assign req_wrap = req_burst;
 always @(posedge clk)begin
 if(req_cmd_vld)begin
 req_type_hold <= req_type ;
 req_wrap_hold <= req_wrap ;
 req_tsize_hold <= req_tsize;
 req_sf_hold <= req_sf ;
 end
 end
 always @(posedge clk)begin
 if(req_cmd_vld)begin
 rsp_tsize <= req_tsize;
 wrsp_addr <= req_addr[QCP_RSP_ADDR_W-1:0];
 rsp_burst <= req_burst;
 rsp_opc <= req_opc ;
 rsp_ctidx <= req_ctidx;
 end
 end
assign req_type = req_opc[1];
assign local_req_fifo_avl = valid_m;
assign req_vld = local_req_fif0_avl && req_block_n;
assign req_wcmd_vld = req_vld && req_hop && req_type;
always @(posedge clk)begin
 if(req_wcmd_vld)
 cfg_rsp_err_rec <= 1'b0;
 else if(wreq_access && cfg_rsp_vld && cfg_rsp_err)
 cfg_rsp_err_rec <= 1'b1;
end
endmodule
module QIC_CBB_RS_FWD
 #(
 parameter PLD_W = 8 
)(
 input wire clk 
 ,input wire reset_n
 ,input wire valid_s 
 ,output wire ready_s 
 ,input wire [PLD_W-1:0] pload_s 
 ,output reg valid_m 
 ,input wire ready_m 
 ,output reg [PLD_W-1:0] pload_m 
 );
 always @(posedge clk or negedge reset_n)begin
 if(reset_n == 1'b0)
 valid_m <= 1'b0;
 else if(valid_s || ready_s)
 valid_m <= valid_s;
 end 
 assign ready_s = ready_m || ~valid_m;
 always @(posedge clk)begin 
 if(valid_s && ready_s)
 pload_m <= pload_s;
 end 
endmodule
